# =============================================================================
# Newtype Decks — Vercel + Neon Postgres Environment Variables
# =============================================================================
# Copy this file to configure your Vercel project environment variables.
# Required vars must be set before deployment. Optional vars enable additional
# features when provided.
#
# Vercel docs: https://vercel.com/docs/environment-variables
# Neon docs:   https://neon.tech/docs/guides/prisma
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (required)
# -----------------------------------------------------------------------------
# Neon pooled connection — used by the app at runtime (via PgBouncer)
DATABASE_URL="postgresql://<user>:<password>@<pooler-host>.neon.tech/<dbname>?sslmode=require&pgbouncer=true"

# Neon direct connection — used by Prisma migrations (bypasses PgBouncer)
# Get this from your Neon dashboard → Connection Details → Direct connection
DIRECT_DATABASE_URL="postgresql://<user>:<password>@<direct-host>.neon.tech/<dbname>?sslmode=require"

# -----------------------------------------------------------------------------
# AUTHENTICATION (required)
# -----------------------------------------------------------------------------
# Full URL of your Vercel deployment (no trailing slash)
NEXTAUTH_URL="https://your-app.vercel.app"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="<32-char-random-secret>"

# -----------------------------------------------------------------------------
# APPLICATION (required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
NEXT_PUBLIC_APP_NAME="Newtype Decks"

# -----------------------------------------------------------------------------
# REDIS (required for production rate limiting — see issue for Redis rollout)
# Currently only used for configuration; in-memory fallbacks are active.
# -----------------------------------------------------------------------------
REDIS_URL="redis://<host>:6379"
# REDIS_PASSWORD=""

# -----------------------------------------------------------------------------
# SENTRY ERROR TRACKING (optional — add DSN when Sentry project is created)
# Using NEXT_PUBLIC_ prefix so the DSN is available on both client and server.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@o<org>.ingest.sentry.io/<project>"
# SENTRY_ORG="your-sentry-org"
# SENTRY_PROJECT="newtypedecks"

# -----------------------------------------------------------------------------
# HEALTH CHECK (optional)
# Bearer token for accessing the verbose /api/health?verbose=true endpoint
# without an admin session. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
# HEALTH_CHECK_TOKEN="<hex-secret>"

# -----------------------------------------------------------------------------
# SOCIAL LOGIN (optional — enable whichever providers you configure)
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=""   # used for client-side OAuth feature flags

# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
# NEXT_PUBLIC_DISCORD_CLIENT_ID=""  # used for client-side OAuth feature flags

# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# FILE STORAGE (optional — required if using Vercel Blob for card images)
# -----------------------------------------------------------------------------
# VERCEL_BLOB_READ_WRITE_TOKEN=""   # from Vercel Storage → Blob → your store
# CDN_BASE_URL=""                   # base URL for card image CDN

# -----------------------------------------------------------------------------
# EMAIL (optional — required for email verification and password reset)
# -----------------------------------------------------------------------------
# EMAIL_SERVER_HOST=""
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_FROM="noreply@your-domain.com"

# -----------------------------------------------------------------------------
# ANALYTICS (optional)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_GA_TRACKING_ID="G-XXXXXXXXXX"   # Google Analytics 4
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"
# MIXPANEL_TOKEN=""

# -----------------------------------------------------------------------------
# LOGGING (optional)
# -----------------------------------------------------------------------------
# LOG_LEVEL="info"         # debug | info | warn | error
# LOG_ENDPOINT=""          # remote log aggregation endpoint
# LOG_FILE=""              # file path for local log output (not used on Vercel)

# -----------------------------------------------------------------------------
# RATE LIMITING (optional — defaults shown)
# NOTE: rate limiting is currently in-memory only. These values are read by
# environment.ts but the Redis-backed implementation is not yet active.
# See GitHub issue for Redis rate limiting rollout.
# -----------------------------------------------------------------------------
# RATE_LIMIT_MAX="100"
# RATE_LIMIT_WINDOW_MS="900000"

# -----------------------------------------------------------------------------
# CORS (optional — defaults to * for all origins)
# Comma-separated list of allowed origins. Leave unset to allow all origins.
# Lock down to your production domain before going live.
# Example: CORS_ORIGINS="https://your-app.vercel.app,https://your-domain.com"
# -----------------------------------------------------------------------------
# CORS_ORIGINS="*"

# -----------------------------------------------------------------------------
# CARD IMAGE STORAGE (admin card editor uploads)
# Local dev needs nothing: images save to uploads/cards/ on disk.
# Production on Vercel: connect a Blob store to the project (Storage tab);
# Vercel injects BLOB_READ_WRITE_TOKEN automatically and uploads switch to
# Vercel Blob. CARD_IMAGE_STORAGE forces a specific driver if ever needed.
# -----------------------------------------------------------------------------
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."   # injected by Vercel, do not set manually
# CARD_IMAGE_STORAGE="local"                   # local | vercel-blob (optional override)
